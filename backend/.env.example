# Copy this file to .env and fill in your own values.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicetask

# Your OpenAI-compatible API key (used for turning speech into structured task actions).
# This can be a real OpenAI key, OR a free key from a compatible provider like
# Groq (console.groq.com) — see OPENAI_BASE_URL below.
OPENAI_API_KEY=sk-...

# Which model to use for intent parsing.
# For OpenAI: gpt-4o-mini
# For Groq (free): llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Leave blank to use OpenAI's own API. To use Groq's free tier instead,
# set this to: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Secret used to sign login sessions (JWTs). Use a long random string —
# e.g. run `openssl rand -hex 32` and paste the output here.
JWT_SECRET=change-this-to-a-long-random-string

# Port the Express server runs on
PORT=4000

# The frontend origin allowed to call this API (Vite's default dev port)
CORS_ORIGIN=http://localhost:5173
