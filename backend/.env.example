# Copy this file to .env and fill in your own values.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicetask

# Your OpenAI API key (used for turning speech into structured task actions)
OPENAI_API_KEY=sk-...

# Which OpenAI model to use for intent parsing
OPENAI_MODEL=gpt-4o-mini

# Secret used to sign login sessions (JWTs). Use a long random string —
# e.g. run `openssl rand -hex 32` and paste the output here.
JWT_SECRET=change-this-to-a-long-random-string

# Port the Express server runs on
PORT=4000

# The frontend origin allowed to call this API (Vite's default dev port)
CORS_ORIGIN=http://localhost:5173
